---
import { alsoHauls, areaLinks, areas } from '../areas';
import '../styles/site.css';

interface NavItem {
	label: string;
	href: string;
}

interface FaqItem {
	question: string;
	answer: string;
}

interface Chrome {
	title: string;
	description: string;
	publicName: string;
	legalName: string;
	phoneTel: string;
	phoneSms: string;
	callLink: string;
	textLink: string;
	pageH1?: string;
	primaryArea?: string;
	faq?: FaqItem[];
	signoff: string;
	nav: NavItem[];
}

const { frontmatter } = Astro.props as { frontmatter: Chrome };
const origin = 'https://comegetthisjunk.com';
const site = `${origin}/`;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, origin).href;
const image = new URL('wordmark.png', site).href;
const tel = frontmatter.phoneTel.replace(/^tel:/, '');
const cityNames = areas.map((area) => area.name);
const areaServed = [
	...(frontmatter.primaryArea
		? [frontmatter.primaryArea, ...cityNames.filter((name) => name !== frontmatter.primaryArea)]
		: cityNames
	).map((name) => ({ '@type': 'City', name })),
	{ '@type': 'AdministrativeArea', name: 'San Fernando Valley' },
];
const servedLine = areaLinks(frontmatter.primaryArea);
const localBusiness = {
	'@type': 'LocalBusiness',
	'@id': `${site}#business`,
	name: frontmatter.publicName,
	legalName: frontmatter.legalName,
	url: site,
	telephone: tel,
	description: frontmatter.description,
	image,
	areaServed,
};
const webPage = {
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	url: canonical,
	name: frontmatter.title,
	description: frontmatter.description,
	isPartOf: { '@id': `${site}#business` },
	about: { '@id': `${site}#business` },
};
const jsonLdGraph = [
	localBusiness,
	webPage,
	...(frontmatter.faq?.length
		? [
				{
					'@type': 'FAQPage',
					'@id': `${canonical}#faq`,
					mainEntity: frontmatter.faq.map(({ question, answer }) => ({
						'@type': 'Question',
						name: question,
						acceptedAnswer: { '@type': 'Answer', text: answer },
					})),
				},
			]
		: []),
];
const jsonLd = { '@context': 'https://schema.org', '@graph': jsonLdGraph };
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={frontmatter.description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site summary" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={frontmatter.publicName} />
		<meta property="og:title" content={frontmatter.title} />
		<meta property="og:description" content={frontmatter.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={frontmatter.title} />
		<meta name="twitter:description" content={frontmatter.description} />
		<meta name="twitter:image" content={image} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{/* Fontshare only honours the first `f[]`; indexed keys must be encoded to get both families. */}
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f%5B0%5D=tanker@400&f%5B1%5D=switzer@400,700,400i,700i&display=swap"
		/>
		<title>{frontmatter.title}</title>
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="1e8db0c2-7bed-4cd9-8835-a43688efd78e"></script>
	</head>
	<body>
		<div class="wordmark">
			<div class="banner"></div>
			<div class="wrap">
				{
					frontmatter.pageH1 ? (
						<div class="logo">
							<a href="/">
								<img src="/wordmark.png" alt={frontmatter.publicName} />
							</a>
						</div>
					) : (
						<h1>
							<a href="#top">
								<img src="/wordmark.png" alt={frontmatter.publicName} />
							</a>
						</h1>
					)
				}
				<button class="menu" type="button" aria-expanded="false" aria-controls="menu-drop" aria-label="Menu">
					<span class="menu-bars"></span>
				</button>
			</div>
			<div class="menu-drop" id="menu-drop">
				<ul class="bursts">
					{
						frontmatter.nav.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<header>
			<div class="wrap">
				<nav>
					<ul class="bursts">
						{
							frontmatter.nav.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<ul class="phones head-phones">
					<li>
						<a class="go" href={frontmatter.phoneSms}>{frontmatter.textLink}</a>
					</li>
					<li>
						<a class="go go-line" href={frontmatter.phoneTel}>{frontmatter.callLink}</a>
					</li>
				</ul>
			</div>
		</header>
		<main id="top" class="wrap">
			<img class="photo" src="/truck.jpg" width="1024" height="468" alt="Come Get This Junk truck, 747-319-6969" />
			<p class="served" id="area" set:html={servedLine} />
			{frontmatter.pageH1 && <h1 class="lede">{frontmatter.pageH1}</h1>}
			{
				frontmatter.primaryArea && (
					<>
						<p class="pitch">
							<a href={frontmatter.phoneSms}>Text a photo</a> of the pile. We name a price,<br class="served-break" /> then show up the same day or the next. You point, we haul.
						</p>
						<ul class="posters">
							<li>
								<a href={frontmatter.phoneSms}>
									<h3>Got a pile?</h3>
									<p>Text a pic to 747-319-6969</p>
								</a>
							</li>
							<li>
								<a href="/#how-it-works">
									<h3>Your price</h3>
									<p>We tell you everything up front</p>
								</a>
							</li>
							<li>
								<a href="#area">
									<h3>The San Fernando Valley</h3>
									<p>We drive out</p>
								</a>
							</li>
							<li>
								<a href="/#odd-jobs">
									<h3>Odd jobs</h3>
									<p>Just ask</p>
								</a>
							</li>
						</ul>
					</>
				)
			}
			<slot />
			{
				frontmatter.primaryArea && (
					<>
						<article class="promise" id="service-promise">
							<h2 class="shout">We show up</h2>
							<p>We love our local customers, and it shows.</p>
							<ul class="claims">
								<li>On time</li>
								<li>Careful in the house</li>
								<li>Cleaner than we found it</li>
							</ul>
							<p class="actions">
								<a class="go" href={frontmatter.phoneSms}>{frontmatter.textLink}</a>
								<a class="go go-line" href={frontmatter.phoneTel}>{frontmatter.callLink}</a>
							</p>
						</article>
						<p class="closer" set:html={alsoHauls(frontmatter.primaryArea)} />
					</>
				)
			}
		</main>
		<footer>
			<div class="wrap">
				<p class="signoff">{frontmatter.signoff}</p>
				<ul class="phones">
					<li>
						<a class="go" href={frontmatter.phoneSms}>{frontmatter.textLink}</a>
					</li>
					<li>
						<a class="go go-line" href={frontmatter.phoneTel}>{frontmatter.callLink}</a>
					</li>
				</ul>
				<ul class="footer-nav">
					{
						frontmatter.nav.map((item) => (
							<li>
								<a class="go go-line" href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
				<ul class="footer-nav footer-areas">
					{
						areas.map((area) => (
							<li>
								<a href={`/${area.slug}/`}>{area.name}</a>
							</li>
						))
					}
				</ul>
				<p class="legal">{frontmatter.legalName}</p>
			</div>
		</footer>
		<dialog class="lightbox" data-lenis-prevent aria-label="Enlarged photo">
			<button class="lightbox-close" type="button" aria-label="Close">×</button>
			<img alt="" />
		</dialog>
		<div class="dock" hidden>
			<a class="go" href={frontmatter.phoneSms}>
				Text
				<svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M448,0H64C28.6,0,0,28.6,0,64v256c0,35.4,28.6,64,64,64h128l-42.7,128l192-128H448c35.4,0,64-28.6,64-64V64C512,28.6,483.4,0,448,0z M128,234.7c-23.6,0-42.7-19.1-42.7-42.7s19.1-42.7,42.7-42.7s42.7,19.1,42.7,42.7S151.6,234.7,128,234.7z M256,234.7c-23.6,0-42.7-19.1-42.7-42.7s19.1-42.7,42.7-42.7s42.7,19.1,42.7,42.7S279.6,234.7,256,234.7z M384,234.7c-23.6,0-42.7-19.1-42.7-42.7s19.1-42.7,42.7-42.7s42.7,19.1,42.7,42.7S407.6,234.7,384,234.7z" /></svg>
			</a>
			<a class="go go-line" href={frontmatter.phoneTel}>
				Call
				<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path transform="translate(-164 -7159)" d="M183.9954,7161.01 C183.9954,7159.906 183.0974,7159.008 181.9934,7159.008 C181.2144,7159.003 182.0424,7159.006 176.9844,7159 C176.4324,7159 175.9744,7159.439 175.9754,7159.991 C175.9754,7160.543 176.4044,7160.973 176.9564,7160.973 L179.3584,7160.997 C179.8044,7160.997 180.0144,7161.523 179.6994,7161.838 L176.0684,7165.469 C175.6784,7165.86 175.6784,7166.493 176.0684,7166.883 C176.4594,7167.274 177.0924,7167.274 177.4834,7166.883 L181.1154,7163.251 C181.4304,7162.936 181.9814,7163.172 181.9814,7163.617 L181.9864,7166.003 C181.9864,7166.555 182.4554,7167.024 183.0084,7167.024 C183.5604,7167.024 184.0004,7166.568 184.0004,7166.016 L183.9954,7161.01 Z M178.1164,7174.578 C177.4214,7174.204 176.7184,7173.778 175.9914,7173.481 C174.5874,7172.908 174.6824,7174.602 173.6784,7175.151 C173.0264,7175.508 172.1074,7174.861 171.5384,7174.503 C170.5444,7173.877 169.6634,7173.053 168.9304,7172.1 C168.5564,7171.613 167.7274,7170.697 167.8294,7170.014 C167.9914,7168.93 169.2744,7168.876 168.9074,7167.55 C168.7114,7166.84 168.3604,7166.141 168.0974,7165.457 C167.7444,7164.54 167.6004,7163.953 166.5724,7164.003 C165.8314,7164.039 165.3384,7164.356 164.8824,7164.951 C163.6494,7166.558 163.8354,7168.725 164.6644,7170.488 C165.8374,7172.983 167.8494,7175.335 169.9994,7176.855 C171.4614,7177.889 173.3874,7178.828 175.1574,7178.987 C176.4534,7179.104 178.2664,7178.403 178.7304,7176.996 C178.6974,7177.094 178.6664,7177.189 178.6514,7177.234 C178.6634,7177.199 178.6864,7177.128 178.7304,7176.996 C178.7764,7176.854 178.8004,7176.783 178.8104,7176.751 C178.7974,7176.793 178.7644,7176.891 178.7314,7176.993 C179.1394,7175.752 179.1884,7175.155 178.1164,7174.578 L178.1164,7174.578 Z" /></svg>
			</a>
		</div>
		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';

			const desktop = matchMedia('(min-width: 40rem)');
			const wordmark = document.querySelector('.wordmark');
			let lenis: Lenis | undefined;

			new ResizeObserver(() => {
				const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
				document.documentElement.style.scrollPaddingTop = `${wordmark.getBoundingClientRect().height + rem}px`;
			}).observe(wordmark);

			document.querySelectorAll('a[href^="#"]').forEach((link) => {
				link.addEventListener('click', (event) => {
					if (!lenis || !(link instanceof HTMLAnchorElement) || !link.hash) return;
					event.preventDefault();
					lenis.scrollTo(link.hash);
					history.pushState(null, '', link.hash);
				});
			});

			addEventListener('popstate', () => {
				if (!lenis) return;
				lenis.scrollTo(location.hash || 0);
			});

			const startLenis = () => {
				if (!desktop.matches || lenis) return;
				lenis = new Lenis({ autoRaf: true });
			};

			const stopLenis = () => {
				lenis?.destroy();
				lenis = undefined;
			};

			desktop.addEventListener('change', () => (desktop.matches ? startLenis() : stopLenis()));
			startLenis();
		</script>
		<script>
			const menu = document.querySelector('.menu');
			const closeMenu = () => menu.setAttribute('aria-expanded', 'false');

			menu.addEventListener('click', () => {
				menu.setAttribute('aria-expanded', menu.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
			});
			document.querySelector('#menu-drop').addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('a')) closeMenu();
			});
			addEventListener('keydown', (event) => {
				if (event.key === 'Escape') closeMenu();
			});
		</script>
		<script>
			const box = document.querySelector('.lightbox') as HTMLDialogElement;
			const big = box.querySelector('img');
			document.querySelectorAll('.zoom button').forEach((button) =>
				button.addEventListener('click', () => {
					const img = button.querySelector('img');
					big.src = img.src;
					big.alt = img.alt;
					box.classList.remove('zoomed');
					box.scrollTo(0, 0);
					box.showModal();
				}),
			);
			big.addEventListener('click', () => box.classList.toggle('zoomed'));
			box.addEventListener('click', (event) => {
				if (event.target === box || (event.target as Element).closest('.lightbox-close')) box.close();
			});
		</script>
		<script>
			const dock = document.querySelector('.dock');
			const footer = document.querySelector('footer');
			const mobile = matchMedia('(max-width: 39.99rem)');
			const sync = () => {
				const footerOn = footer.getBoundingClientRect().top < innerHeight;
				dock.hidden = !(scrollY > 40 && !footerOn && mobile.matches);
			};
			addEventListener('scroll', sync, { passive: true });
			addEventListener('resize', sync);
			mobile.addEventListener('change', sync);
			sync();
		</script>
	</body>
</html>
